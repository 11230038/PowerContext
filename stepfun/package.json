{
  "name": "seeklocal-knowledge-base",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "check": "tsc --noEmit && eslint . --max-warnings=0 && vitest run",
    "lint": "eslint . --max-warnings=0"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "express": "5.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "seekdb": "1.4.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/express": "5.0.5",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.0",
    "concurrently": "9.2.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "8.0.0",
    "vitest": "4.0.6"
  }
}
